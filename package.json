{
  "name": "@vecrea/au3te-ts-hono",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "deploy": "wrangler deploy --minify src/index.tsx",
    "build": "esbuild src/lambda.tsx --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/client-secrets-manager": "^3.862.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "@squilla/hono-aws-middlewares": "^1.1.1",
    "@vecrea/au3te-ts-common": "^0.1.2",
    "@vecrea/au3te-ts-server": "^0.1.4",
    "@vecrea/oid4vc-core": "^0.1.0",
    "hono": "^4.5.5",
    "samlify": "^2.10.2",
    "samlify-validator-js": "^0.0.1",
    "u8a-utils": "^1.0.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240529.0",
    "@eslint/js": "^9.39.1",
    "@hono/eslint-config": "^2.0.3",
    "@types/aws-lambda": "^8.10.153",
    "@types/node": "^24.2.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "wrangler": "^4.24.3"
  }
}
